{
  "name": "tend-behavior-change-game",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p jsconfig.json && node --check public/theme.js && node --check vite.config.js",
    "test": "node --test src/application/*.test.js src/domain/*.test.js src/data/*.test.js src/features/*/*.test.js",
    "test:domain": "node --test src/domain/*.test.js",
    "test:data": "node --test src/application/*.test.js src/data/*.test.js",
    "test:ui": "node --test src/features/*/*.test.js",
    "test:db": "supabase test db",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "supabase": "^2.109.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.110.8"
  }
}
